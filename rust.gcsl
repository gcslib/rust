# The rust library: Rust programs, built by Cargo from the crates a
# workspace's `Cargo.lock` pins.
#
# - `Toolchain::Rust`: a Rust toolchain, a `RustToolchain`: `root`, rustc,
#   Cargo and the standard libraries of its targets, laid out as one
#   install; `runtime`, a root they run on; `cc`, the C compiler that links
#   what rustc compiles, and `cc_root`, its install; `clippy`, Clippy's
#   component, whose `bin/clippy-driver` runs with `root`'s libraries.
# - `rust_1_98`: Rust 1.98.1 from static.rust-lang.org, each part pinned by
#   its SHA-256, with the standard libraries of `x86_64-unknown-linux-gnu`
#   and `x86_64-unknown-linux-musl`, running on the gcc library's Bootlin
#   sysroot and linking with its compiler. rustc needs zlib, which the
#   sysroot lacks: zlib, from its pinned source, is built with the buildenv
#   library's pinned environment and put beside rustc's own libraries.
# - `Crate`: a crate of crates.io, as `Cargo.lock` pins it: its name,
#   version and checksum, the SHA-256 of its `.crate` file.
# - `GitCrate`: a crate of a git repository, as `Cargo.lock` pins it: its
#   name and version, and its source, `source`, as the lock writes it
#   before its commit, `git+URL?rev=REV` say, which Cargo's configuration
#   names it by, its `url`, and the `commit` it is pinned to by its whole
#   name.
# - `crates(lock)`: every crate of crates.io the `Cargo.lock` file `lock`
#   pins, in its order; `git_crates(lock)`, every crate of a git repository.
#   A crate from anywhere else is an error: only crates.io's are pinned by a
#   checksum, and a git repository's by a commit. A crate of the workspace
#   itself, which has no source, is the workspace's.
# - `vendored(lock)`: the crates `lock` pins, as Cargo builds from them with
#   no network, a `Vendored`: `crates`, a directory of each under
#   `NAME-VERSION`, as `cargo vendor` lays them out, those of crates.io
#   fetched by their checksums and unpacked, and those of a git repository
#   its directory in the repository's files at its commit, found by its
#   manifest's name and given whole, for Cargo to find each by its name and
#   version; `git`, the git sources, for Cargo to find in it; and `locals`,
#   each package of no source, the workspace's own and those it takes by
#   their paths, as `NAME@VERSION`. A git crate whose manifest takes a value
#   from its workspace's, `version.workspace = true` say, or names a path,
#   a sibling crate's, has its manifest written, by `normalize.py`, to build
#   on its own: each value it takes written in, each path dependency on a
#   crate of the repository one on that crate in the git source it is
#   pinned from, at its exact version, and its development dependencies,
#   which Cargo never resolves for it, left out. A git crate of a
#   repository the workspace also imports a library from at another
#   commit than its host pinned the library at (`libraries`'s
#   `pinned_libraries`): the library's settings for the crate and the crate
#   must be of one commit.
# - `cargo_build(src, vendor, bins)`: the binaries `bins` of the Cargo
#   workspace `src`, built by `cargo build --release --frozen --offline`
#   from the crates of `vendor`, for `target`, by default
#   `x86_64-unknown-linux-musl`: a directory of each by its name. Its
#   `rustflags` follow the target unless given: for a musl target, static
#   position-independent programs, which need nothing of the system they run
#   on, and none for any other. The C a crate compiles through `cc`,
#   `zstd-sys`'s say, is compiled for the target by `target_c`, by default
#   the gcc library's musl toolchain for a musl target, which a static musl
#   program needs, and the registered C toolchain for any other. `beside` are directories
#   the source takes by their paths, each placed at its path, `at`, beside
#   the source as `../AT` reaches it: another repository's crate, say.
#   `libs` are libraries it builds to give besides the binaries,
#   `libpeios.a` say; `env`, what Cargo gives every build script besides,
#   each by its name; and `libclang`, a directory holding the `libclang.so`
#   a build script's bindgen loads, for which it is given too the target C
#   toolchain's own headers and sysroot to parse with. A hermetic step: Cargo runs in a sandbox of the toolchain's
#   runtime, with the toolchain, the source and the crates, and nothing else.
#   Its target directory is in the step's `#[scratch]` directory, so that a
#   build after a change to the source compiles the crates of `vendor` no
#   more. Cargo tells a changed file by its modification time, which a
#   file put back as it was can make older than its last build, so each
#   package of `vendor.locals` is cleaned first and always compiled again.
#   A crate of `vendor`, by its name, version and source, never changes.
# - `cargo_sources(vendor)`: the sections of Cargo's configuration that
#   make it take every crate from `vendor`, as `cargo vendor` prints them.
# - `default_rustflags(target)`, `default_target_c(target)`: the flags and
#   the C toolchain a build for `target` takes unless given, as
#   `cargo_build` describes them; `builtin_headers(c)`, the directory of the
#   C compiler's own headers in the C toolchain `c`, from its root.
#
# `crates.gcsl` builds a workspace one crate at a time instead: see its
# `workspace`.
import fs
import libraries
import unpack from archive
import toolchain
import Toolchain from toolchain
import Toolchain::Python python_3_14 from "github.com/gcslib/python"
import PythonToolchain from "github.com/gcslib/python"
import * from "github.com/gcslib/gcc"
import * from "github.com/gcslib/buildenv"

type RustToolchain = {root: Dir, runtime: Dir, cc: File, cc_root: Dir, clippy: Dir}

enum Toolchain::Rust<RustToolchain>

type Crate = {name: String, version: String, checksum: String}

type GitCrate = {name: String, version: String, source: String, url: String, commit: String}

type Vendored = {crates: Dir, git: List<GitCrate>, locals: List<String>}

let DIST = "https://static.rust-lang.org/dist"

# The target of the machine builds run on, which builds scripts for.
let HOST = "x86_64-unknown-linux-gnu"

# Where a build's sandbox has the toolchain, and the C compiler that links.
let OPT_RUST = "/opt/rust"

let OPT_CC = "/opt/cc"

# Where a build's sandbox has the C toolchain of its target.
let OPT_TARGET_CC = "/opt/target-cc"

# Where a build's sandbox has the libclang its build scripts' bindgen loads.
let OPT_LIBCLANG = "/opt/libclang"

# Where `cargo_build` keeps Cargo's target directory between its runs.
let SCRATCH_TARGET = "/pekit-scratch/target"

def Toolchain::Rust rust_1_98() {
    let gcc = (Toolchain::C gcc_x86_64)().made()
    let c: Toolchain = gcc.provides
    let linker = Toolchain::C.payload(c)
    let pinned = (Toolchain::BuildEnv busybox_x86_64)().made()
    let e: Toolchain = pinned.provides
    let zlib = configure_make(zlib_source(), cchain = linker, env = Toolchain::BuildEnv.payload(e))
    host_platform = {arch = "x86_64"; os = "linux"}
    platform = {}
    provides = {
        root = installed(
            part("rustc", "rustc", "e974f036b28565f37c0f3bd92ddefa809bee16c04f9dcf07b9ed96e05aaaf7c4"),
            part("cargo", "cargo", "ea1de9f9e23107d97ee2b41a72c552f34064a593da503789218387aee59f3ba4"),
            [
                part(
                    "rust-std",
                    "rust-std-x86_64-unknown-linux-gnu",
                    "fa3ff450172a16c026944030230c5069947af93c728d9179971d44e5e0cfb561",
                ),
                part(
                    "rust-std",
                    "rust-std-x86_64-unknown-linux-musl",
                    "bd9f35880de21dab0e387e84009c00001ae7836a4ba565cb16823f13f75f325f",
                    target = "x86_64-unknown-linux-musl",
                ),
            ],
            zlib.dir("lib"),
        )
        runtime = linker.runtime
        cc = linker.cc
        cc_root = linker.root
        clippy = part(
            "clippy",
            "clippy-preview",
            "e167f333be24e1d5eea56ea563c7def0aa0bd613f5ce3445976c93b0288799d1",
        )
    }
}

# The component `component` of the part `name` of Rust 1.98.1, for
# `target`, its archive pinned by `sha256`, unpacked.
fn part(
    name: String,
    component: String,
    sha256: String,
    target: String = "x86_64-unknown-linux-gnu",
) -> Dir {
    let archive = fetch("{DIST}/{name}-1.98.1-{target}.tar.xz", sha256 = sha256)
    = unpack(archive).dir("{name}-1.98.1-{target}/{component}")
}

# zlib's source, pinned.
fn zlib_source() -> Dir {
    let archive = fetch(
        "https://zlib.net/fossils/zlib-1.3.1.tar.gz",
        sha256 = "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23",
    )
    = unpack(archive).dir("zlib-1.3.1")
}

# rustc, Cargo and the standard libraries `std`, each a component's tree,
# laid out as one install, with zlib's libraries `zlib` among rustc's, where
# it finds its own. Each tree has a manifest of its own at its top, which is
# left out.
#[hermetic]
fn installed(rustc: Dir, cargo: Dir, std: List<Dir>, zlib: Dir) -> Dir {
    # Cargo's component has no libraries.
    let parts = [rustc, ...std]
    let entries = [
        ...(for part in parts { = {at = "lib"; place = part.dir("lib")} }),
        {at = "lib"; place = zlib},
        {at = "bin"; place = rustc.dir("bin")},
        {at = "bin"; place = cargo.dir("bin")},
        {at = "libexec"; place = rustc.dir("libexec")},
    ]
    = fs.compose(entries)
}

# A `[[package]]` block of a `Cargo.lock` file: the value of each key a
# lock's crates are read by, the last if it has several, `""` if none.
type LockPackage = {name: String, version: String, source: String, checksum: String}

# Each `[[package]]` block of the `Cargo.lock` file `lock`; what is before
# the first is left out. Memoised, so that a build reads and splits the lock
# once, however often its targets' code runs.
fn packages(lock: File) ->> List<LockPackage> {
    let blocks = lock.read().split("[[package]]")
    let mut found: List<LockPackage> = []
    let mut first = true
    for block in blocks {
        if first {
            first := false
            continue
        }
        let mut name = ""
        let mut version = ""
        let mut source = ""
        let mut checksum = ""
        for line in block.lines() {
            let halves = line.split(" = \"")
            if len(halves) != 2 {
                continue
            }
            let value = halves[1].strip_suffix("\"")
            if halves[0] == "name" {
                name := value
            } else if halves[0] == "version" {
                version := value
            } else if halves[0] == "source" {
                source := value
            } else if halves[0] == "checksum" {
                checksum := value
            }
        }
        found := [...found, {name = name; version = version; source = source; checksum = checksum}]
    }
    = found
}

def crates(lock: File) ->> List<Crate> {
    let mut found: List<Crate> = []
    for package in packages(lock) {
        let source = package.source
        if source == "" or source.starts_with("git+") {
            continue
        }
        if not source.starts_with("registry+https://github.com/rust-lang/crates.io-index") {
            panic("`{package.name}` {package.version} is from `{source}`: only crates of crates.io, pinned by a checksum, and of git repositories, pinned by a commit, are")
        }
        found := [...found, {name = package.name; version = package.version; checksum = package.checksum}]
    }
    = found
}

def git_crates(lock: File) ->> List<GitCrate> {
    let mut found: List<GitCrate> = []
    for package in packages(lock) {
        let pinned = package.source
        if not pinned.starts_with("git+") {
            continue
        }
        # `git+URL?rev=REV#COMMIT`: Cargo names the source by what is before
        # the commit, and the repository is the URL before any query.
        let halves = pinned.split("#")
        let source = halves[0]
        let commit = if len(halves) == 2 { halves[1] } else { "" }
        let url = source.strip_prefix("git+").split("?")[0]
        found := [...found, {name = package.name; version = package.version; source = source; url = url; commit = commit}]
    }
    = found
}

def vendored(lock: File) -> Vendored {
    let pins_agree = agreed(git_crates(lock))
    let fetched = for each in crates(lock) {
        let archive = fetch(
            "https://static.crates.io/crates/{each.name}/{each.name}-{each.version}.crate",
            sha256 = each.checksum,
        )
        = {crate = each; tree = unpack(archive, strip = 1)}
    }
    let git = git_crates(lock)
    let repositories = for each in git {
        let repository = fetch_git(each.url, each.commit)
        let found = crate_dir(repository, each.name)
        let place = if found.normalize {
            normalized(repository, found.within, each.source, file("normalize.py"))
        } else if found.within == "" {
            repository
        } else {
            repository.dir(found.within)
        }
        = {crate = each; place = place}
    }
    let mut locals: List<String> = []
    for package in packages(lock) {
        if package.source == "" {
            locals := [...locals, "{package.name}@{package.version}"]
        }
    }
    = {crates = vendor(fetched, repositories); git = git; locals = locals}
}

# Fails unless each of `git`, a lock's git crates, from a repository the
# workspace also imports a library from is at the commit its host pinned
# the library at: the crate and the library, a crate's build settings say,
# must be of one commit, and only a person can say which moves.
fn agreed(git: List<GitCrate>, ^pinned_libraries) -> {} {
    for each in git {
        for pin in pinned_libraries {
            if same_repository(each.url, pin.git) and each.commit != pin.commit {
                panic(
                    "`Cargo.lock` pins `{each.name}` at `{each.commit}` of `{each.url}`, but `pekit.lock` pins \
                     the library `{pin.path}` from the same repository at `{pin.commit}`: update one, \
                     `cargo update -p {each.name}` or `pekit lock --update`, so that both are the same commit",
                )
            }
        }
    }
    = {}
}

# Whether the git URLs `a` and `b` name one repository: equal but for a
# `.git` or `/` at the end.
fn same_repository(a: String, b: String) -> Bool {
    let bare = fn(url: String) -> String { = url.strip_suffix("/").strip_suffix(".git") }
    = bare(a) == bare(b)
}

# The directory of the crate `name` in the repository files `repository`,
# from its root, `""` for the root itself: the one whose manifest's
# `[package]` names it; and whether its manifest is to be normalized, as it
# takes values from its workspace's or names a path, a sibling crate's say,
# which a crate given on its own has neither of.
fn crate_dir(repository: Dir, name: String) -> {within: String, normalize: Bool} {
    let mut found: List<{within: String, normalize: Bool}> = []
    for each in repository.files() {
        let path = each.path.strip_prefix(repository.path).strip_prefix("/")
        if not (path == "Cargo.toml" or path.ends_with("/Cargo.toml")) {
            continue
        }
        let text = each.read()
        let mut in_package = false
        for line in text.lines() {
            let line = line.trim()
            if line.starts_with("[") {
                in_package := line == "[package]"
            } else if in_package and line == "name = \"{name}\"" {
                found := [...found, {within = path.strip_suffix("Cargo.toml").strip_suffix("/"); normalize = text.contains("workspace = true") or text.contains("path =")}]
            }
        }
    }
    if len(found) != 1 {
        panic("the git repository `{repository.path}` has {len(found)} crates named `{name}`, not one")
    }
    = found[0]
}

# The python library's pinned Python, which normalizes git crates'
# manifests.
fn vendoring_python() -> PythonToolchain {
    let made = (Toolchain::Python python_3_14)().made()
    let python: Toolchain = made.provides
    = Toolchain::Python.payload(python)
}

# The crate at `within` in the repository files `repository`, its manifest
# written for it to build on its own, by `tool`, `normalize.py`, with the
# python library's pinned Python: each value it takes from its workspace's
# written in, each dependency on a sibling crate's path one on that crate
# in the git source `source` it is pinned from, at its exact version, and
# its development dependencies left out.
#[hermetic]
fn normalized(repository: Dir, within: String, source: String, tool: File, python: PythonToolchain = vendoring_python()) -> Dir {
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = python.runtime},
        {at = "/opt/python"; place = python.root},
        {at = "/work/repository"; place = repository},
        {at = "/work/normalize.py"; place = tool},
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work")
    let python_at = "/opt/python/{python.python.path.strip_prefix(python.root.path).strip_prefix("/")}"
    let ran = box.exec(python_at, "-I", "/work/normalize.py", "/work/repository", if within == "" { "." } else { within }, source, "/work/out/crate")
    = box.dir("/work/out/crate")
}

# The crates `fetched`, each with its unpacked tree, as `cargo vendor` lays
# them out: each under `NAME-VERSION`, with the record of its checksum Cargo
# reads, which names no file, so that Cargo checks the crate it was given
# against its pin and its files against nothing more.
#[hermetic]
fn vendor(
    fetched: List<{crate: Crate, tree: Dir}>,
    repositories: List<{crate: GitCrate, place: Dir}>,
) -> Dir {
    let records = working_dir().path
    # A git crate's record names no checksum: its commit pins it.
    let git_record = "{records}/git.json"
    let wrote = fs.write(git_record, "{{\"files\": {{}}, \"package\": null}}")
    let from_git = for each in repositories {
        let at = "{each.crate.name}-{each.crate.version}"
        let pair: List<{at: String, place: Dir | File | FileSet}> = [
            {at = at; place = each.place},
            {at = "{at}/.cargo-checksum.json"; place = file(git_record)},
        ]
        = pair
    }
    let entries = for each in fetched {
        let at = "{each.crate.name}-{each.crate.version}"
        let record = "{records}/{at}.json"
        let written = fs.write(record, "{{\"files\": {{}}, \"package\": \"{each.crate.checksum}\"}}")
        let pair: List<{at: String, place: Dir | File | FileSet}> = [
            {at = at; place = each.tree},
            {at = "{at}/.cargo-checksum.json"; place = file(record)},
        ]
        = pair
    }
    let mut flat: List<{at: String, place: Dir | File | FileSet}> = []
    for pair in [...entries, ...from_git] {
        flat := [...flat, ...pair]
    }
    = fs.compose(flat)
}

# The flags a build for `target` takes unless given: static,
# position-independent programs for a musl target, which need nothing of the
# system they run on, and none for any other.
def default_rustflags(target: String) -> List<String> {
    = if target.ends_with("-musl") {
        ["-Crelocation-model=pic", "-Clink-self-contained=yes", "-Clink-arg=-static-pie"]
    } else {
        []
    }
}

# The C toolchain that compiles a crate's C for `target` unless one is
# given: the gcc library's musl toolchain for a musl target, else the
# registered C toolchain.
def default_target_c(target: String) -> toolchain.CToolchain {
    = if target.ends_with("-musl") { gcc_x86_64_musl() } else { toolchain.get(Toolchain::C) }
}

# The directory of the C compiler's own headers, `stddef.h`'s, in the C
# toolchain `c`, from its install's root: what `cc -print-file-name=include`
# says.
def builtin_headers(c: toolchain.CToolchain) ->> String {
    for each in c.root.dir("lib/gcc").files() {
        if each.path.ends_with("/include/stddef.h") {
            return each.path.strip_prefix(c.root.path).strip_prefix("/").strip_suffix("/stddef.h")
        }
    }
    panic("the C toolchain at `{c.root.path}` has no `lib/gcc/*/include/stddef.h`")
}

def cargo_sources(vendor: Vendored): String {
    # Each git source, found among the vendored crates, as `cargo vendor`
    # writes it: the repository and its query, a revision say.
    let mut git_sources = ""
    let mut seen: List<String> = []
    for each in vendor.git {
        if seen.contains(each.source) {
            continue
        }
        seen := [...seen, each.source]
        let parts = each.source.split("?")
        let pairs: List<String> = if len(parts) == 2 { parts[1].split("&") } else { [] }
        let mut query = ""
        for pair in pairs {
            let kv = pair.split("=")
            query := "{query}{kv[0]} = \"{kv[1]}\"\n"
        }
        git_sources := "{git_sources}[source.\"{each.source}\"]\ngit = \"{each.url}\"\n{query}replace-with = \"vendored\"\n"
    }
    = "[source.crates-io]\nreplace-with = \"vendored\"\n{git_sources}[source.vendored]\ndirectory = \"/work/vendor\"\n"
}

#[hermetic]
#[scratch]
def cargo_build(
    src: Dir,
    vendor: Vendored,
    bins: List<String>,
    target: String = "x86_64-unknown-linux-musl",
    packages: List<String> = [],
    rustflags: List<String> = default_rustflags(target),
    beside: List<{at: String, place: Dir}> = [],
    libs: List<String> = [],
    env: List<Entry<String>> = [],
    libclang: List<Dir> = [],
    rust: RustToolchain = toolchain.get(Toolchain::Rust),
    target_c: toolchain.CToolchain = default_target_c(target),
) -> Dir {
    let home = working_dir().path
    let config = "{home}/config.toml"
    let cc = "{OPT_CC}/{rust.cc.path.strip_prefix(rust.cc_root.path).strip_prefix("/")}"
    # The C of a crate for the target, its build script's through `cc`,
    # compiled by the target's own C toolchain, musl's for a musl target, and
    # for the build's own machine by the one that links.
    let target_cc = "{OPT_TARGET_CC}/{target_c.cc.path.strip_prefix(target_c.root.path).strip_prefix("/")}"
    let target_ar = "{OPT_TARGET_CC}/{target_c.ar.path.strip_prefix(target_c.root.path).strip_prefix("/")}"
    let target_var = target.split("-").join("_")
    # The flags as the build's own, which a project's configuration of its
    # target's flags overrides, as Cargo means it to: `RUSTFLAGS` would
    # override the project's.
    let quoted_flags = (for flag in rustflags { = "\"{flag}\"" }).join(", ")
    # What a build script is given besides, and, for one that runs bindgen,
    # the libclang it loads, and the target C toolchain's own headers and
    # sysroot for it to parse with, as the toolchain's compiler would.
    let mut given = ""
    for each in env {
        given := "{given}{each.key} = \"{each.value}\"\n"
    }
    for each in libclang {
        let builtin = builtin_headers(target_c)
        let sysroot = target_c.sysroot.path.strip_prefix(target_c.root.path)
        given := "{given}LIBCLANG_PATH = \"{OPT_LIBCLANG}\"\n\
                  BINDGEN_EXTRA_CLANG_ARGS = \"-isystem {OPT_TARGET_CC}/{builtin} --sysroot={OPT_TARGET_CC}{sysroot}\"\n"
    }
    # The build's own machine links build scripts with the same compiler;
    # a target that is that machine has the one section.
    let host = if target == HOST { "" } else { "[target.{HOST}]\nlinker = \"{cc}\"\n" }
    let written = fs.write(
        config,
        "{cargo_sources(vendor)}\
         [target.{target}]\nlinker = \"{cc}\"\n{host}\
         [env]\nCC_{target_var} = \"{target_cc}\"\nAR_{target_var} = \"{target_ar}\"\n{given}\
         [build]\nrustflags = [{quoted_flags}]\n",
    )
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = rust.runtime},
        {at = OPT_RUST; place = rust.root},
        {at = OPT_CC; place = rust.cc_root},
        {at = OPT_TARGET_CC; place = target_c.root},
        ...(for each in libclang { = {at = OPT_LIBCLANG; place = each} }),
        {at = "/work/src"; place = src},
        ...(for each in beside { = {at = "/work/{each.at}"; place = each.place} }),
        {at = "/work/vendor"; place = vendor.crates},
        {at = "/work/home/config.toml"; place = file(config)},
    ]
    let box = fs.compose(placed).sandbox(
        cwd = "/work/src",
        env = {
            PATH = "{OPT_RUST}/bin:{OPT_CC}/bin"
            HOME = "/work/home"
            CARGO_HOME = "/work/home"
            CARGO_TARGET_DIR = SCRATCH_TARGET
        },
    )
    let mut cleaned = ["clean", "--release", "--frozen", "--offline", "--target", target]
    for spec in vendor.locals {
        cleaned := [...cleaned, "-p", spec]
    }
    # With no package named, `cargo clean` would clean every crate.
    let cleaning: List<List<String>> = if len(vendor.locals) > 0 { [cleaned] } else { [] }
    let clean = for each in cleaning { = box.exec("{OPT_RUST}/bin/cargo", ...each) }
    let chosen = for name in packages { = ["-p", name] }
    let mut words = ["build", "--release", "--frozen", "--offline", "--target", target]
    for pair in chosen {
        words := [...words, ...pair]
    }
    let built = box.exec("{OPT_RUST}/bin/cargo", ...words)
    = fs.compose(for name in [...bins, ...libs] { = {at = name; place = file("{SCRATCH_TARGET}/{target}/release/{name}")} })
}
