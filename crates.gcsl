# Cargo workspaces built one crate at a time: each crate, with its
# features, each build script and each run of one a step of its own, as
# Bazel's rules_rust builds them, so that a change rebuilds only the crates
# it reaches, and two programs share the crates they both use.
#
# - `workspace(src, vendor)`: the Cargo workspace `src`, its crates from
#   `vendor`, as `vendored` gives them, planned for `target`, by default
#   `x86_64-unknown-linux-gnu`: a `RustWorkspace`. Cargo plans it: what each
#   member's build and tests are, unit by unit, as `cargo build --unit-graph`
#   says, each crate with the features Cargo resolves for that member alone,
#   so that a member's features never reach another's crates. Planning reads
#   the manifests, the lock and which files there are, never what the
#   sources say, so a change to a source plans nothing again. `rustflags`
#   are given to every crate built for the target, after Cargo's, as
#   `RUSTFLAGS` would be; `crates` are settings of particular packages, a
#   `CrateSettings` each; `libclang` a directory holding the `libclang.so`
#   build scripts' bindgen loads, as `cargo_build` has it.
# - `CrateSettings`: what a package needs that its manifest does not say:
#   `data`, files and directories its compiles and its build script read
#   besides its own directory, each placed at `at` under the workspace, as
#   `registry.d` beside the package that `include_str!`s it; `env`, what its
#   build script and its compiles are given besides; and `given`, files and
#   directories placed at the absolute paths `at` for its build script, its
#   compiles and those of every crate that depends on it, a library a build
#   script links with, say.
# - `bin(ws, package, name)`: the program `name` of the member `package`,
#   by default its own name; `library(ws, package)`: its shared library,
#   its `cdylib`; `static_library(ws, package)`: its static archive, its
#   `staticlib`. Each takes `features`, as `cargo build --features` does.
# - `tests(ws, package)`: the test programs of the member `package`, its
#   unit tests and each integration test, with `features` too if given, as
#   `cargo test --features` builds them: a `RustTest` each, by its name;
#   `run_test(test)` runs one, a step, in a sandbox of the toolchain's
#   runtime with a writable `/tmp`, `given` placed at their paths, `env`
#   set and `args` its arguments, and fails if it does.
# - `doctests(ws, package)`: the tests of the member `package`'s
#   documentation, each crate's run by rustdoc as a step, as `cargo test
#   --doc` runs them, with `given` and `env` as `run_test` has them; none
#   for a member with no library whose documentation is tested.
# - `clippy(ws, package)`: Clippy's checks of the member `package`, as
#   `cargo clippy --all-targets` checks it, each of its crates a step,
#   `flags` given after the lints, `-Dwarnings` say. A check fails as its
#   compile would, so a lint denied fails it.
# - `docs(ws, package)`: the documentation of the member `package`'s
#   library, made by rustdoc as a step, as `cargo doc --no-deps` makes it,
#   `flags` given after the lints, `-Dwarnings` say: the directory rustdoc
#   wrote. It fails as rustdoc does, so a lint denied fails it.
#
# A member's crates are compiled with what Cargo takes from its manifest
# that its plans omit, as `manifests.py` reads it with the python library's
# pinned Python: its `[lints]`, or its workspace's, its `--check-cfg`
# flags, and which of its targets have no test harness.
#
# Each step's sandbox holds the toolchain, the crate's own directory, at its
# path in the workspace or among the vendored crates, and what it is given,
# nothing else. Each program a step runs is given exactly the environment
# Cargo would give it, made with `record` from the variables' names.
# A dependency's output and a build script's are placed at their paths in
# `pekit-out`, which name them, so that what a crate is compiled with is the
# same wherever it is built from.
import fs
import json
import path
import toolchain
import Toolchain from toolchain
import Toolchain::Python python_3_14 from "github.com/gcslib/python"
import PythonToolchain from "github.com/gcslib/python"

# Where a step's sandbox has the toolchain, the C compiler that links, the
# target's C toolchain and libclang, as `cargo_build`'s has them.
let OPT_RUST = "/opt/rust"

let OPT_CC = "/opt/cc"

let OPT_TARGET_CC = "/opt/target-cc"

let OPT_LIBCLANG = "/opt/libclang"

# Where the step that reads the manifests has Python.
let OPT_PYTHON = "/opt/python"

# Where a step's sandbox has the workspace, the vendored crates, and the
# output directory of the build script that runs there or whose crate is
# compiled there.
let SRC = "/work/src"

let VENDOR = "/work/vendor"

let OUT = "/work/out"

# The target of the machine builds run on, which build scripts and proc
# macros are built for.
let HOST = "x86_64-unknown-linux-gnu"

# The keys of a build script's directives that are no metadata.
let RESERVED = ["rerun-if-changed", "rerun-if-env-changed", "warning", "error", "rustc-check-cfg"]

type CrateSettings = {
    package: String,
    data: List<{at: String, place: Dir | File}> = [],
    env: List<Entry<String>> = [],
    given: List<{at: String, place: Dir | File}> = [],
}

# A package as `cargo metadata` describes it: what Cargo tells a build of
# it in `CARGO_PKG_*`, and where its manifest is.
type MetaPackage = {
    name: String,
    version: String,
    id: String,
    manifest_path: String,
    links: String = "",
    authors: List<String> = [],
    description: String = "",
    homepage: String = "",
    repository: String = "",
    license: String = "",
    license_file: String = "",
    rust_version: String = "",
    readme: String = "",
}

type Metadata = {packages: List<MetaPackage>, workspace_members: List<String>}

# A unit of a build as `cargo build --unit-graph` describes it.
type UnitTarget = {kind: List<String>, crate_types: List<String>, name: String, src_path: String, edition: String}

type UnitProfile = {
    opt_level: String,
    debuginfo: Int | String = 0,
    debug_assertions: Bool,
    overflow_checks: Bool,
    panic: String = "unwind",
    lto: String = "false",
    codegen_units: Int = 0,
}

type UnitDep = {index: Int, extern_crate_name: String}

type Unit = {
    pkg_id: String,
    target: UnitTarget,
    profile: UnitProfile,
    platform: String = "",
    mode: String,
    features: List<String>,
    dependencies: List<UnitDep>,
}

type UnitGraph = {units: List<Unit>, roots: List<Int>}

# What Cargo takes from a member's manifest that its plans omit, as
# `manifests.py` describes it.
type PackageFacts = {
    id: String,
    lints: List<String>,
    check_cfg: List<String>,
    plain: List<{kind: String, name: String}>,
    doctest: Bool,
}

# The manifests and lock of a workspace, which planning reads, each placed
# at its path, and the path of every other file, which it is given empty.
type Skeleton = {manifests: List<{at: String, place: File}>, paths: List<String>}

type RustWorkspace = {
    src: Dir,
    vendor: Vendored,
    target: String,
    rustflags: List<String>,
    crates: List<CrateSettings>,
    libclang: List<Dir>,
    rust: RustToolchain,
    target_c: toolchain.CToolchain,
    skeleton: Skeleton,
    metadata: Metadata,
    facts: List<PackageFacts>,
    target_cfg: File,
    host_cfg: File,
}

def workspace(
    src: Dir,
    vendor: Vendored,
    target: String = "x86_64-unknown-linux-gnu",
    rustflags: List<String> = [],
    crates: List<CrateSettings> = [],
    libclang: List<Dir> = [],
    ignore: List<String> = ["target", "pekit-out"],
    rust: RustToolchain = toolchain.get(Toolchain::Rust),
    target_c: toolchain.CToolchain = default_target_c(target),
    python: PythonToolchain = pinned_python(),
) ->> RustWorkspace {
    let skeleton = skeleton_of(src, ignore)
    let described = cargo_metadata(rust, skeleton, vendor, target)
    let metadata: Metadata = json.decode(described.read())
    let facts: List<PackageFacts> = json.decode(manifest_facts(python, skeleton, described, file("manifests.py")).read())
    = {
        src = src
        vendor = vendor
        target = target
        rustflags = rustflags
        crates = crates
        libclang = libclang
        rust = rust
        target_c = target_c
        skeleton = skeleton
        metadata = metadata
        facts = facts
        target_cfg = rustc_cfg(rust, target, rustflags)
        host_cfg = rustc_cfg(rust, HOST)
    }
}

# The python library's pinned Python, which reads the manifests.
fn pinned_python() -> PythonToolchain {
    let made = (Toolchain::Python python_3_14)().made()
    let python: Toolchain = made.provides
    = Toolchain::Python.payload(python)
}

# The skeleton of the workspace `src`: its manifests, its lock, and
# `.cargo` configuration, as they are, and every other file's path, but
# those under a hidden directory, Cargo's own among them, or one of
# `ignore` at the top, a build's outputs.
fn skeleton_of(src: Dir, ignore: List<String>) ->> Skeleton {
    let found = for each in src.files() {
        = {at = each.path.strip_prefix(src.path).strip_prefix("/"); place = each}
    }
    # `ignore` first: a build's outputs, pekit's among them, are most of the
    # files.
    let kept = for each in found if not ignore.contains(each.at.split("/")[0]) and not hidden(each.at) {
        = each
    }
    = {
        manifests = for each in kept if is_manifest(each.at) { = each }
        paths = for each in kept if not is_manifest(each.at) { = each.at }
    }
}

# Whether the path `at` is under a hidden directory, or is a hidden file,
# but for Cargo's own configuration, `.cargo`.
fn hidden(at: String) -> Bool {
    # Most paths have no part to look at: only one that begins with `.`.
    if not at.starts_with(".") and not at.contains("/.") {
        return false
    }
    = (for part in at.split("/") if part.starts_with(".") and part != ".cargo" { = part }).len() > 0
}

# Whether the path `at` is one of the files Cargo plans by: a manifest, a
# lock, or `.cargo` configuration.
fn is_manifest(at: String) -> Bool {
    let name = path.basename(at)
    = name == "Cargo.toml" or name == "Cargo.lock" or at.starts_with(".cargo/")
}

# --- Planning ---

# A sandbox of the toolchain, the skeleton of a workspace at `/work/src`
# and its vendored crates, in which Cargo plans a build for `target`.
fn planned_in(rust: RustToolchain, skeleton: Skeleton, vendor: Vendored, target: String) -> Sandbox {
    let home = working_dir().path
    let empty = "{home}/empty"
    let made = fs.write(empty, "")
    let config = "{home}/config.toml"
    let cc = "{OPT_CC}/{rust.cc.path.strip_prefix(rust.cc_root.path).strip_prefix("/")}"
    let host = if target == HOST { "" } else { "[target.{HOST}]\nlinker = \"{cc}\"\n" }
    let wrote = fs.write(config, "{cargo_sources(vendor)}[target.{target}]\nlinker = \"{cc}\"\n{host}")
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = rust.runtime},
        {at = OPT_RUST; place = rust.root},
        {at = OPT_CC; place = rust.cc_root},
        ...(for each in skeleton.manifests { = {at = "{SRC}/{each.at}"; place = each.place} }),
        ...(for each in skeleton.paths { = {at = "{SRC}/{each}"; place = file(empty)} }),
        {at = VENDOR; place = vendor.crates},
        {at = "/work/home/config.toml"; place = file(config)},
    ]
    = fs.compose(placed).sandbox(
        cwd = SRC,
        env = {
            PATH = "{OPT_RUST}/bin:{OPT_CC}/bin"
            HOME = "/work/home"
            CARGO_HOME = "/work/home"
            CARGO_TARGET_DIR = "/work/target"
            RUSTC_BOOTSTRAP = "1"
        },
    )
}

# What `cargo metadata` says of the workspace whose skeleton is `skeleton`,
# for `target`.
#[hermetic]
fn cargo_metadata(rust: RustToolchain, skeleton: Skeleton, vendor: Vendored, target: String) -> File {
    let box = planned_in(rust, skeleton, vendor, target)
    let ran = box.exec(
        "{OPT_RUST}/bin/cargo",
        "metadata",
        "--format-version",
        "1",
        "--frozen",
        "--offline",
        "--filter-platform",
        target,
    )
    let at = "{working_dir().path}/metadata.json"
    let wrote = fs.write(at, ran.stdout)
    = file(at)
}

# What `reader`, `manifests.py`, makes of the manifests of the workspace
# whose skeleton is `skeleton`, and of `metadata`, what `cargo metadata`
# says of it: a JSON list of `PackageFacts`.
#[hermetic]
fn manifest_facts(python: PythonToolchain, skeleton: Skeleton, metadata: File, reader: File) -> File {
    let at = "{working_dir().path}/facts.json"
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = python.runtime},
        {at = OPT_PYTHON; place = python.root},
        ...(for each in skeleton.manifests { = {at = "{SRC}/{each.at}"; place = each.place} }),
        {at = "/work/metadata.json"; place = metadata},
        {at = "/work/manifests.py"; place = reader},
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work")
    let python_at = "{OPT_PYTHON}/{python.python.path.strip_prefix(python.root.path).strip_prefix("/")}"
    let ran = box.exec(python_at, "-I", "/work/manifests.py", "/work/metadata.json", "/work/facts.json")
    = box.file("/work/facts.json")
}

# The units of the member `package`'s plan for `target`, as `cargo
# --unit-graph` makes it: of its build if `mode` is `build`, of its tests if
# `test`, of every target `cargo clippy --all-targets` checks if `clippy`,
# and of its documentation's tests if `doc`.
#[hermetic]
fn unit_graph(
    rust: RustToolchain,
    skeleton: Skeleton,
    vendor: Vendored,
    target: String,
    package: String,
    mode: String,
    features: List<String>,
) -> File {
    let box = planned_in(rust, skeleton, vendor, target)
    let how = if mode == "test" {
        ["test", "--no-run"]
    } else if mode == "clippy" {
        ["test", "--no-run", "--all-targets"]
    } else if mode == "doc" {
        ["test", "--doc"]
    } else {
        ["build"]
    }
    let chosen: List<String> = if len(features) > 0 { ["--features", features.join(",")] } else { [] }
    let ran = box.exec(
        "{OPT_RUST}/bin/cargo",
        ...how,
        "--unit-graph",
        "-Z",
        "unstable-options",
        "--release",
        "--frozen",
        "--offline",
        "--target",
        target,
        "-p",
        package,
        ...chosen,
    )
    let at = "{working_dir().path}/{mode}.json"
    let wrote = fs.write(at, ran.stdout)
    = file(at)
}

# The configuration `rustc --print cfg` gives for `target`, with `flags`.
#[hermetic]
fn rustc_cfg(rust: RustToolchain, target: String, flags: List<String> = []) -> File {
    let box = fs.compose([{at = "/"; place = rust.runtime}, {at = OPT_RUST; place = rust.root}]).sandbox(cwd = "/")
    let ran = box.exec("{OPT_RUST}/bin/rustc", "--print", "cfg", "--target", target, ...flags)
    let at = "{working_dir().path}/cfg.txt"
    let wrote = fs.write(at, ran.stdout)
    = file(at)
}

# --- Environments ---

# The environment of `entries`, a variable named twice taking its last
# value, as Cargo's does when a build script's `rustc-env` names one it set.
fn environment(entries: List<Entry<String>>) -> {*: String} {
    let mut kept: List<Entry<String>> = []
    let mut seen: List<String> = []
    for i in 0..len(entries) {
        let each = entries[len(entries) - 1 - i]
        if not seen.contains(each.key) {
            seen := [...seen, each.key]
            kept := [each, ...kept]
        }
    }
    = record(kept)
}

# --- Building ---

# What a unit came to: its kind, `lib`, `proc-macro`, `bin`, `cdylib`,
# `staticlib`, `test`, `script` for a build script's program, or `run` for a
# run of one; its step's output; the artifacts it made there, the first the
# one its dependents are given; by their units' numbers, the libraries it
# needs, transitively, and the runs of the build scripts of the crates it
# needs, its own among them; and what those crates' packages are given.
type Built = {
    kind: String,
    dir: Dir | Future<Dir>,
    files: List<String> = [],
    libraries: List<Int> = [],
    runs: List<Int> = [],
    given: List<{at: String, place: Dir | File}> = [],
}

# What a compile is given: the arguments known before its dependencies are
# built, its environment and working directory, what its sandbox holds
# besides the toolchain, and, once built, the libraries it is given by
# name, the libraries they need, its own build script's run, if it has one,
# the runs of the build scripts of the crates it needs, and which of its own
# build script's link arguments apply to it.
type CompileSpec = {
    args: List<String>,
    env: List<Entry<String>>,
    cwd: String,
    placed: List<{at: String, place: Dir | File}>,
    externs: List<{name: String, dir: Dir | Future<Dir>, file: String}>,
    libraries: List<Dir | Future<Dir>>,
    out: List<Dir | Future<Dir>>,
    runs: List<Dir | Future<Dir>>,
    link: String,
}

# What a build script's run is given: its program, its environment and
# working directory, what its sandbox holds besides the toolchain, the runs
# of the build scripts of the packages it depends on that link a native
# library, by the library's name, and the configuration of the machine it
# builds for.
type RunSpec = {
    script: Dir | Future<Dir>,
    program: String,
    env: List<Entry<String>>,
    cwd: String,
    placed: List<{at: String, place: Dir | File}>,
    links: List<{links: String, dir: Dir | Future<Dir>}>,
    cfg: File,
}

# A test program of a member, by its name, with what runs it.
type RustTest = {name: String, program: File, rust: RustToolchain}

# A unit being built: its number in its graph, its package and that
# package's settings, what its sandbox holds of its package, and what the
# packages it depends on are given.
type UnitAt = {
    index: Int,
    package: MetaPackage,
    settings: CrateSettings,
    placed: List<{at: String, place: Dir | File}>,
    given: List<{at: String, place: Dir | File}>,
}

def bin(ws: RustWorkspace, package: String, name: String = package, features: List<String> = []) -> File {
    let graph = planned(ws, package, "build", features)
    let mut root = -1
    for i in 0..len(graph.units) {
        let unit = graph.units[i]
        if unit.mode == "build" and unit.target.kind.contains("bin") and unit.target.name == name {
            root := i
        }
    }
    if root < 0 {
        panic("the member `{package}` has no program `{name}`")
    }
    let made = built(ws, graph, [root])
    = made[root].dir.file(made[root].files[0])
}

def library(ws: RustWorkspace, package: String, features: List<String> = []) -> File {
    = linked(ws, package, "cdylib", ".so", features)
}

def static_library(ws: RustWorkspace, package: String, features: List<String> = []) -> File {
    = linked(ws, package, "staticlib", ".a", features)
}

# The library of the crate type `kind` of the member `package`, whose file
# ends with `suffix`, with `features`: one compile makes every crate type its
# manifest names, as Cargo does.
fn linked(ws: RustWorkspace, package: String, kind: String, suffix: String, features: List<String>) -> File {
    let graph = planned(ws, package, "build", features)
    let mut root = -1
    for i in 0..len(graph.units) {
        if graph.units[i].mode == "build" and graph.units[i].target.crate_types.contains(kind) {
            root := i
        }
    }
    if root < 0 {
        panic("the member `{package}` has no `{kind}` library")
    }
    let made = built(ws, graph, [root])
    let found = for each in made[root].files if each.ends_with(suffix) { = each }
    = made[root].dir.file(found[0])
}

def tests(ws: RustWorkspace, package: String, features: List<String> = []) -> List<RustTest> {
    let graph = planned(ws, package, "test", features)
    let roots = for i in 0..len(graph.units) if graph.units[i].mode == "test" { = i }
    let made = built(ws, graph, roots)
    = for i in roots {
        = {
            name = graph.units[i].target.name
            program = made[i].dir.file(made[i].files[0])
            rust = ws.rust
        }
    }
}

#[hermetic]
def run_test(
    test: RustTest,
    given: List<{at: String, place: Dir | File}> = [],
    env: List<Entry<String>> = [],
    args: List<String> = [],
) -> {} {
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = test.rust.runtime},
        {at = "/work/test"; place = test.program},
        ...(for each in given { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work")
    let ran = box.exec("/work/test", ...args, env = environment([{key = "PATH"; value = "/usr/bin:/bin"}, ...env]))
}

def doctests(
    ws: RustWorkspace,
    package: String,
    features: List<String> = [],
    given: List<{at: String, place: Dir | File}> = [],
    env: List<Entry<String>> = [],
) -> List<{}> {
    if not facts_of(ws, member_id(ws, package)).doctest {
        return []
    }
    let graph = planned(ws, package, "doc", features)
    let roots = for i in 0..len(graph.units) if graph.units[i].mode == "doctest" { = i }
    let made = built(ws, graph, needs(graph, roots))
    = for i in roots {
        = doctested(ws.rust, doctest_of(ws, graph, made, unit_at(ws, graph, made, i)), given, env)
    }
}

def clippy(
    ws: RustWorkspace,
    package: String,
    features: List<String> = [],
    flags: List<String> = [],
) -> List<{}> {
    # Its library, programs and build script, as they are built, and each
    # target as its tests and checks build it.
    = [
        ...checked(ws, planned(ws, package, "build", features), package, flags),
        ...checked(ws, planned(ws, package, "clippy", features), package, flags),
    ]
}

def docs(
    ws: RustWorkspace,
    package: String,
    features: List<String> = [],
    flags: List<String> = [],
) -> Dir {
    # Its library as its build has it, the crates it depends on built as
    # they are for that build.
    let graph = planned(ws, package, "build", features)
    let id = member_id(ws, package)
    let found = for i in 0..len(graph.units) if graph.units[i].pkg_id == id and graph.units[i].mode == "build" and is_library(graph.units[i].target) {
        = i
    }
    if len(found) == 0 {
        panic("the member `{package}` has no library to document")
    }
    let made = built(ws, graph, needs(graph, found))
    = documented(ws.rust, doc_of(ws, graph, made, unit_at(ws, graph, made, found[0])), flags)
}

# Whether `target` is a package's library, and not a program, a test, a
# benchmark, an example or a build script.
fn is_library(target: UnitTarget): Bool {
    = (for each in ["bin", "test", "bench", "example", "custom-build"] if target.kind.contains(each) { = each }).len() == 0
}

# Clippy's checks of the crates of the member `package` that `graph` has,
# but its build script's runs, with `flags`. Clippy lints only the packages
# Cargo was asked for, so the other members `graph` has are left out.
fn checked(ws: RustWorkspace, graph: UnitGraph, package: String, flags: List<String>) -> List<{}> {
    let id = member_id(ws, package)
    let chosen = for i in 0..len(graph.units) if graph.units[i].pkg_id == id and graph.units[i].mode != "run-custom-build" {
        = i
    }
    let made = built(ws, graph, needs(graph, chosen))
    = for i in chosen {
        = clippy_checked(ws.rust, compile_of(ws, graph, made, unit_at(ws, graph, made, i)).spec, flags)
    }
}

# The units the units `roots` of `graph` depend on, each once.
fn needs(graph: UnitGraph, roots: List<Int>) -> List<Int> {
    let mut found: List<Int> = []
    for i in roots {
        for dep in graph.units[i].dependencies {
            found := [...found, dep.index]
        }
    }
    = found.unique()
}

# The package ID of the workspace member `package`.
fn member_id(ws: RustWorkspace, package: String) -> String {
    for each in ws.metadata.packages {
        if each.name == package and ws.metadata.workspace_members.contains(each.id) {
            return each.id
        }
    }
    panic("the workspace has no member `{package}`")
}

# How rustdoc tests the documentation of the library that the doctest unit
# `at` of `graph` names, those it depends on built as `made` has them, as
# Cargo has it test them: given what its compile would be, but no profile,
# no native libraries and no link arguments of its own.
fn doctest_of(ws: RustWorkspace, graph: UnitGraph, made: List<Built>, at: UnitAt) -> CompileSpec {
    let unit = graph.units[at.index]
    let target = unit.target
    let facts = facts_of(ws, unit.pkg_id)
    let compiled = compile_of(ws, graph, made, at).spec
    let none: List<String> = []
    let args = [
        "--edition={target.edition}",
        ...(for each in target.crate_types { = "--crate-type={each}" }),
        "--crate-name={target.name.split("-").join("_")}",
        "--test",
        target.src_path.strip_prefix("{SRC}/"),
        "--test-run-directory={path.dirname(at.package.manifest_path)}",
        ...facts.lints,
        "-Cembed-bitcode=no",
        ...(for each in unit.features { = "--cfg=feature=\"{each}\"" }),
        ...facts.check_cfg,
        "-Clinker={OPT_CC}/{ws.rust.cc.path.strip_prefix(ws.rust.cc_root.path).strip_prefix("/")}",
        ...(if unit.platform == "" { none } else { ["--target={ws.target}"] }),
    ]
    = {
        args = args
        env = compiled.env
        cwd = compiled.cwd
        placed = compiled.placed
        externs = compiled.externs
        libraries = compiled.libraries
        out = compiled.out
        runs = compiled.runs
        link = ""
    }
}

# How rustdoc documents the library that the unit `at` of `graph` builds,
# those it depends on built as `made` has them, as Cargo has it document
# it: given what its compile would be, but no profile, no native libraries
# and no link arguments of its own, and told the package's version.
fn doc_of(ws: RustWorkspace, graph: UnitGraph, made: List<Built>, at: UnitAt) -> CompileSpec {
    let unit = graph.units[at.index]
    let target = unit.target
    let facts = facts_of(ws, unit.pkg_id)
    let compiled = compile_of(ws, graph, made, at).spec
    let none: List<String> = []
    let args = [
        "--edition={target.edition}",
        ...(for each in target.crate_types { = "--crate-type={each}" }),
        "--crate-name={target.name.split("-").join("_")}",
        target.src_path.strip_prefix("{SRC}/"),
        ...facts.lints,
        ...(for each in unit.features { = "--cfg=feature=\"{each}\"" }),
        ...facts.check_cfg,
        "--crate-version={at.package.version}",
        ...(if unit.platform == "" { none } else { ["--target={ws.target}"] }),
    ]
    = {
        args = args
        env = compiled.env
        cwd = compiled.cwd
        placed = compiled.placed
        externs = compiled.externs
        libraries = compiled.libraries
        out = compiled.out
        runs = compiled.runs
        link = ""
    }
}

# The units of the member `package`'s build, or its tests' if `mode` is
# `test`, as Cargo plans them.
fn planned(ws: RustWorkspace, package: String, mode: String, features: List<String> = []) ->> UnitGraph {
    let graph: UnitGraph = json.decode(unit_graph(ws.rust, ws.skeleton, ws.vendor, ws.target, package, mode, features).read())
    = graph
}

# What each unit of `graph` that the units `roots` need came to, by its
# number, built in an order each unit's dependencies come before it in; the
# others are left as nothing was made of them.
fn built(ws: RustWorkspace, graph: UnitGraph, roots: List<Int>) ->> List<Built> {
    let count = len(graph.units)
    # The units the roots need.
    let mut needed = for i in 0..count { = false }
    let mut pending = roots
    for len(pending) > 0 {
        let i = pending[len(pending) - 1]
        pending := for k in 0..(len(pending) - 1) { = pending[k] }
        if needed[i] {
            continue
        }
        needed[i] := true
        for dep in graph.units[i].dependencies {
            pending := [...pending, dep.index]
        }
    }
    let nothing: Built = {kind = ""; dir = ws.src}
    let mut made = for i in 0..count { = nothing }
    let mut done = for i in 0..count { = not needed[i] }
    let mut left = (for i in 0..count if needed[i] { = i }).len()
    for left > 0 {
        let mut progressed = false
        for i in 0..count {
            if done[i] {
                continue
            }
            let mut ready = true
            for dep in graph.units[i].dependencies {
                if not done[dep.index] {
                    ready := false
                }
            }
            if not ready {
                continue
            }
            made[i] := unit_built(ws, graph, made, i)
            done[i] := true
            left := left - 1
            progressed := true
        }
        if not progressed {
            panic("Cargo's plan has a cycle among its units")
        }
    }
    = made
}

# What the unit number `i` of `graph` comes to, those it depends on built
# as `made` has them.
fn unit_built(ws: RustWorkspace, graph: UnitGraph, made: List<Built>, i: Int) -> Built {
    let at = unit_at(ws, graph, made, i)
    if graph.units[i].mode == "run-custom-build" {
        return script_ran(ws, graph, made, at)
    }
    = compiled(ws, graph, made, at)
}

# The unit number `i` of `graph` as it is built, those it depends on built
# as `made` has them.
fn unit_at(ws: RustWorkspace, graph: UnitGraph, made: List<Built>, i: Int) -> UnitAt {
    let unit = graph.units[i]
    let package = package_of(ws, unit.pkg_id)
    let settings = settings_of(ws, package.name)
    let root = path.dirname(package.manifest_path)
    # Its data, and its own directory unless its data holds it.
    let data = for each in settings.data { = {at = "{SRC}/{each.at}"; place = each.place} }
    let within = (for each in data if root == each.at or root.starts_with("{each.at}/") { = each.at }).len() > 0
    let own: List<{at: String, place: Dir | File}> = if within { [] } else { [{at = root; place = crate_dir(ws, root)}] }
    let placed: List<{at: String, place: Dir | File}> = [...own, ...data]
    let mut given = settings.given
    for dep in unit.dependencies {
        for each in made[dep.index].given {
            if not (for had in given { = had.at }).contains(each.at) {
                given := [...given, each]
            }
        }
    }
    = {
        index = i
        package = package
        settings = settings
        placed = placed
        given = given
    }
}

# The crate or build script that the unit `at` of `graph` compiles, those
# it depends on built as `made` has them.
fn compiled(ws: RustWorkspace, graph: UnitGraph, made: List<Built>, at: UnitAt) -> Built {
    let planned = compile_of(ws, graph, made, at)
    = {
        kind = planned.kind
        dir = compile(ws.rust, planned.spec)
        files = planned.files
        libraries = planned.libraries
        runs = planned.runs
        given = at.given
    }
}

# How the unit `at` of `graph` is compiled, those it depends on built as
# `made` has them: what it is, the artifacts it makes, the units of the
# libraries and build-script runs it needs, and what rustc is given.
fn compile_of(ws: RustWorkspace, graph: UnitGraph, made: List<Built>, at: UnitAt) -> {
    kind: String,
    files: List<String>,
    libraries: List<Int>,
    runs: List<Int>,
    spec: CompileSpec,
} {
    let unit = graph.units[at.index]
    let target = unit.target
    let crate = target.name.split("-").join("_")
    let script = target.kind.contains("custom-build")
    let host = unit.platform == ""
    let member = ws.metadata.workspace_members.contains(unit.pkg_id)
    let facts = facts_of(ws, unit.pkg_id)
    let root = path.dirname(at.package.manifest_path)
    # What it is given of the units it depends on: the libraries it names,
    # those they need, and the build-script runs, its own and theirs.
    let mut externs: List<{name: String, dir: Dir | Future<Dir>, file: String}> = []
    let mut libraries: List<Int> = []
    let mut runs: List<Int> = []
    let mut out: List<Dir | Future<Dir>> = []
    for dep in unit.dependencies {
        let given = made[dep.index]
        if given.kind == "run" {
            out := [given.dir]
            runs := [...runs, dep.index]
            continue
        }
        externs := [...externs, {name = dep.extern_crate_name; dir = given.dir; file = given.files[0]}]
        libraries := [...libraries, dep.index]
        # A proc macro runs in the compiler: what it links is none of the
        # crate's to search.
        if given.kind != "proc-macro" {
            libraries := [...libraries, ...given.libraries]
            runs := [...runs, ...given.runs]
        }
    }
    libraries := libraries.unique()
    runs := runs.unique()
    let kind = if unit.mode == "test" {
        "test"
    } else if script {
        "script"
    } else if target.crate_types.contains("proc-macro") {
        "proc-macro"
    } else if target.crate_types.contains("bin") {
        "bin"
    } else {
        "lib"
    }
    let files = artifacts(kind, crate, target.crate_types)
    # A test target with no harness is a program of its own, compiled for
    # tests, as Cargo compiles it.
    let library = is_library(target)
    let harnessed = (for each in facts.plain if target.name == each.name and (target.kind.contains(each.kind) or (each.kind == "lib" and library)) {
        = each
    }).len() == 0
    let types = if kind == "test" {
        if harnessed { ["--test"] } else { ["--cfg=test"] }
    } else {
        for each in target.crate_types { = "--crate-type={if each == "lib" { "rlib" } else { each }}" }
    }
    # Cargo gives a workspace member's path relative to the workspace, from
    # which it runs rustc, and any other crate's in full.
    let source = if member { target.src_path.strip_prefix("{SRC}/") } else { target.src_path }
    let features = for each in unit.features { = "--cfg=feature=\"{each}\"" }
    let none: List<String> = []
    let args = [
        "--crate-name={crate}",
        "--edition={target.edition}",
        source,
        ...types,
        ...lto_args(lto_of(graph)[at.index]),
        ...profile_args(unit.profile),
        ...facts.lints,
        ...features,
        ...facts.check_cfg,
        "-Cmetadata={unit.pkg_id} {unit.mode} {target.name} {unit.platform} {unit.features.join(",")}",
        "-Clinker={OPT_CC}/{ws.rust.cc.path.strip_prefix(ws.rust.cc_root.path).strip_prefix("/")}",
        ...(if host { none } else { ["--target={ws.target}", ...ws.rustflags] }),
        ...(if member { none } else { ["--cap-lints=allow"] }),
        ...(if kind == "proc-macro" { ["--extern=proc_macro"] } else { none }),
    ]
    let link = if kind == "bin" {
        "bins:{target.name}"
    } else if kind == "test" {
        "tests"
    } else if target.crate_types.contains("cdylib") {
        "cdylib"
    } else {
        ""
    }
    let spec: CompileSpec = {
        args = args
        env = [...crate_env(ws, at.package, unit, crate), ...at.settings.env]
        cwd = SRC
        placed = [...at.placed, ...at.given]
        externs = externs
        libraries = for each in libraries { = made[each].dir }
        out = out
        runs = for each in runs { = made[each].dir }
        link = link
    }
    = {kind = kind; files = files; libraries = libraries; runs = runs; spec = spec}
}

# What Cargo takes from the manifest of the package `id` that its plans
# omit: nothing for a package outside the workspace.
fn facts_of(ws: RustWorkspace, id: String) -> PackageFacts {
    for each in ws.facts {
        if each.id == id {
            return each
        }
    }
    let none: PackageFacts = {id = id; lints = []; check_cfg = []; plain = []; doctest = false}
    = none
}

# The artifacts rustc makes of the crate `crate` of the kind `kind` and the
# crate types `types`, the one dependents are given first.
fn artifacts(kind: String, crate: String, types: List<String>) -> List<String> {
    if kind == "test" or kind == "bin" or kind == "script" {
        return [crate]
    }
    if kind == "proc-macro" {
        return ["lib{crate}.so"]
    }
    # The Rust library first, which its dependents link with, whatever
    # order the manifest names the types in.
    let rust = for each in types if each == "lib" or each == "rlib" { = "lib{crate}.rlib" }
    let others = for each in types if each != "lib" and each != "rlib" {
        = if each == "staticlib" { "lib{crate}.a" } else { "lib{crate}.so" }
    }
    = [...rust, ...others]
}

# What rustc is told of a unit's link-time optimisation, `lto`, as
# `lto_of` gives it, as Cargo tells it.
fn lto_args(lto: String) -> List<String> {
    if lto == "run" {
        return ["-Clto"]
    }
    if lto.starts_with("run=") {
        return ["-Clto={lto.strip_prefix("run=")}"]
    }
    if lto == "off" {
        return ["-Clto=off"]
    }
    if lto == "bitcode" {
        return ["-Clinker-plugin-lto"]
    }
    if lto == "object" {
        return ["-Cembed-bitcode=no"]
    }
    # `both`, object code and bitcode, is rustc's own default.
    let none: List<String> = []
    = none
}

# The link-time optimisation each unit of `graph` takes, by its number, as
# Cargo's `lto.rs` works it out from the roots down: `run`, or `run=` and
# its kind, for a unit that is linked and optimised whole; `off`; `bitcode`
# for a library only such a unit links; `object` for one only an
# unoptimised link, a build script or a proc macro needs; `both` for one
# both kinds need; and `""` for a unit no root reaches.
fn lto_of(graph: UnitGraph) ->> List<String> {
    let count = len(graph.units)
    let mut found = for i in 0..count { = "" }
    let mut pending: List<{unit: Int, parent: String}> = for root in graph.roots {
        = {unit = root; parent = root_lto(graph.units[root])}
    }
    for len(pending) > 0 {
        let next = pending[0]
        pending := for k in 1..len(pending) { = pending[k] }
        let lto = unit_lto(graph.units[next.unit], next.parent)
        let had = found[next.unit]
        let merged = merged_lto(lto, had)
        if merged == had {
            continue
        }
        found[next.unit] := merged
        for dep in graph.units[next.unit].dependencies {
            pending := [...pending, {unit = dep.index; parent = merged}]
        }
    }
    = found
}

# The crate types Cargo works out a unit's link-time optimisation by: a
# test's are a program's.
fn lto_types(unit: Unit) -> List<String> {
    if unit.mode == "test" or unit.mode == "bench" or unit.mode == "doctest" {
        return ["bin"]
    }
    = unit.target.crate_types
}

# Whether the unit `unit` is built for the host alone: a build script or a
# proc macro.
fn for_host(unit: Unit) -> Bool {
    = unit.target.kind.contains("custom-build") or unit.target.crate_types.contains("proc-macro")
}

# Whether one of the crate types `types` needs object code.
fn needs_object(types: List<String>) -> Bool {
    = (for each in types if ["bin", "staticlib", "cdylib", "dylib"].contains(each) { = each }).len() > 0
}

# What a unit of the crate types `types`, which need object code, takes
# under a parent that optimises at link time.
fn lto_needing_object(types: List<String>) -> String {
    = if (for each in types if each != "dylib" { = each }).len() == 0 { "object" } else { "both" }
}

# What the root `unit` asks of itself, before its own is worked out.
fn root_lto(unit: Unit) -> String {
    let lto = unit.profile.lto
    if lto == "false" {
        return "object"
    }
    if lto == "off" {
        return "off"
    }
    let types = unit.target.crate_types
    = if for_host(unit) { "object" } else if needs_object(types) { lto_needing_object(types) } else { "bitcode" }
}

# The link-time optimisation of `unit` under a parent whose is `parent`.
fn unit_lto(unit: Unit, parent: String) -> String {
    let types = lto_types(unit)
    let linked = (for each in types if not ["bin", "staticlib", "cdylib"].contains(each) { = each }).len() == 0
    if for_host(unit) {
        return "object"
    }
    if linked {
        let lto = unit.profile.lto
        return if lto == "false" { "object" } else if lto == "true" { "run" } else if lto == "off" { "off" } else { "run={lto}" }
    }
    let needs = needs_object(types)
    let running = parent == "run" or parent.starts_with("run=")
    if running and not needs {
        return "bitcode"
    }
    if (running or parent == "bitcode") and needs {
        return lto_needing_object(types)
    }
    = parent
}

# What a unit takes when it is reached twice, once needing `lto` and once
# `had`: enough for both.
fn merged_lto(lto: String, had: String) -> String {
    if had == "" or lto == had {
        return lto
    }
    if lto == "run" or lto.starts_with("run=") {
        return lto
    }
    if had == "run" or had.starts_with("run=") {
        return had
    }
    if lto == "off" or had == "off" {
        return "off"
    }
    = "both"
}

# What rustc is told of the profile `profile`, as Cargo tells it.
fn profile_args(profile: UnitProfile) -> List<String> {
    let mut args = ["-Copt-level={profile.opt_level}"]
    let debuginfo = profile.debuginfo
    if debuginfo is Int {
        if debuginfo == 0 {
            args := [...args, "-Cstrip=debuginfo"]
        } else {
            args := [...args, "-Cdebuginfo={debuginfo}"]
        }
    } else {
        args := [...args, "-Cdebuginfo={debuginfo}"]
    }
    let switch = fn(on: Bool): String { if on { "on" } else { "off" } }
    args := [
        ...args,
        "-Cdebug-assertions={switch(profile.debug_assertions)}",
        "-Coverflow-checks={switch(profile.overflow_checks)}",
    ]
    if profile.panic == "abort" {
        args := [...args, "-Cpanic=abort"]
    }
    if profile.codegen_units > 0 {
        args := [...args, "-Ccodegen-units={profile.codegen_units}"]
    }
    = args
}

# What Cargo gives rustc's environment for the crate `crate` of `package`'s
# unit `unit`.
fn crate_env(ws: RustWorkspace, package: MetaPackage, unit: Unit, crate: String) -> List<Entry<String>> {
    let version = package.version.split("+")[0]
    let release = version.split("-")
    let numbers = release[0].split(".")
    let pre = if len(release) > 1 { (for k in 1..len(release) { = release[k] }).join("-") } else { "" }
    let root = path.dirname(package.manifest_path)
    let mut env = [
        {key = "PATH"; value = "{OPT_RUST}/bin:{OPT_CC}/bin"},
        {key = "CARGO"; value = "{OPT_RUST}/bin/cargo"},
        {key = "CARGO_MANIFEST_DIR"; value = root},
        {key = "CARGO_MANIFEST_PATH"; value = package.manifest_path},
        {key = "CARGO_PKG_NAME"; value = package.name},
        {key = "CARGO_PKG_VERSION"; value = package.version},
        {key = "CARGO_PKG_VERSION_MAJOR"; value = numbers[0]},
        {key = "CARGO_PKG_VERSION_MINOR"; value = if len(numbers) > 1 { numbers[1] } else { "" }},
        {key = "CARGO_PKG_VERSION_PATCH"; value = if len(numbers) > 2 { numbers[2] } else { "" }},
        {key = "CARGO_PKG_VERSION_PRE"; value = pre},
        {key = "CARGO_PKG_AUTHORS"; value = package.authors.join(":")},
        {key = "CARGO_PKG_DESCRIPTION"; value = package.description},
        {key = "CARGO_PKG_HOMEPAGE"; value = package.homepage},
        {key = "CARGO_PKG_REPOSITORY"; value = package.repository},
        {key = "CARGO_PKG_LICENSE"; value = package.license},
        {key = "CARGO_PKG_LICENSE_FILE"; value = package.license_file},
        {key = "CARGO_PKG_RUST_VERSION"; value = package.rust_version},
        {key = "CARGO_PKG_README"; value = package.readme},
        {key = "CARGO_CRATE_NAME"; value = crate},
    ]
    if unit.target.kind.contains("bin") {
        env := [...env, {key = "CARGO_BIN_NAME"; value = unit.target.name}]
    }
    if ws.metadata.workspace_members.contains(unit.pkg_id) {
        env := [...env, {key = "CARGO_PRIMARY_PACKAGE"; value = "1"}]
    }
    if unit.mode == "test" and unit.target.kind.contains("test") {
        env := [...env, {key = "CARGO_TARGET_TMPDIR"; value = "/tmp"}]
    }
    = env
}

# The build-script run the unit `at` of `graph` is, those it depends on
# built as `made` has them.
fn script_ran(ws: RustWorkspace, graph: UnitGraph, made: List<Built>, at: UnitAt) -> Built {
    let unit = graph.units[at.index]
    let host = unit.platform == ""
    let target = if host { HOST } else { ws.target }
    let root = path.dirname(at.package.manifest_path)
    let mut scripts: List<Built> = []
    let mut links: List<{links: String, dir: Dir | Future<Dir>}> = []
    for dep in unit.dependencies {
        let given = made[dep.index]
        if given.kind == "script" {
            scripts := [given]
        } else if given.kind == "run" {
            let linked = package_of(ws, graph.units[dep.index].pkg_id).links
            if linked != "" {
                links := [...links, {links = linked; dir = given.dir}]
            }
        }
    }
    if len(scripts) != 1 {
        panic("the build-script run of `{at.package.name}` has no build script")
    }
    let profile = unit.profile
    let debuginfo = profile.debuginfo
    let debug = if debuginfo is Int { debuginfo != 0 } else { true }
    let rustflags: List<String> = if host { [] } else { ws.rustflags }
    let target_var = target.split("-").join("_")
    let target_cc = "{OPT_TARGET_CC}/{ws.target_c.cc.path.strip_prefix(ws.target_c.root.path).strip_prefix("/")}"
    let target_ar = "{OPT_TARGET_CC}/{ws.target_c.ar.path.strip_prefix(ws.target_c.root.path).strip_prefix("/")}"
    let cc = "{OPT_CC}/{ws.rust.cc.path.strip_prefix(ws.rust.cc_root.path).strip_prefix("/")}"
    let mut env = [
        ...crate_env(ws, at.package, unit, "build_script_build"),
        {key = "OUT_DIR"; value = OUT},
        {key = "TARGET"; value = target},
        {key = "HOST"; value = HOST},
        {key = "PROFILE"; value = "release"},
        {key = "OPT_LEVEL"; value = profile.opt_level},
        {key = "DEBUG"; value = if debug { "true" } else { "false" }},
        {key = "NUM_JOBS"; value = "1"},
        {key = "RUSTC"; value = "{OPT_RUST}/bin/rustc"},
        {key = "RUSTDOC"; value = "{OPT_RUST}/bin/rustdoc"},
        {key = "RUSTC_LINKER"; value = cc},
        {key = "CARGO_ENCODED_RUSTFLAGS"; value = rustflags.join("\u{1f}")},
        {key = "CARGO_MANIFEST_LINKS"; value = at.package.links},
        {key = "CC_{target_var}"; value = if host { cc } else { target_cc }},
        {key = "AR_{target_var}"; value = if host { "{OPT_CC}/bin/{ar_of(cc)}" } else { target_ar }},
        ...(for each in unit.features { = {key = "CARGO_FEATURE_{upper(each.split("-").join("_"))}"; value = "1"} }),
        ...at.settings.env,
    ]
    if len(ws.libclang) > 0 {
        let builtin = builtin_headers(ws.target_c)
        let sysroot = ws.target_c.sysroot.path.strip_prefix(ws.target_c.root.path)
        env := [
            ...env,
            {key = "LIBCLANG_PATH"; value = OPT_LIBCLANG},
            {key = "BINDGEN_EXTRA_CLANG_ARGS"; value = "-isystem {OPT_TARGET_CC}/{builtin} --sysroot={OPT_TARGET_CC}{sysroot}"},
        ]
    }
    let spec: RunSpec = {
        script = scripts[0].dir
        program = scripts[0].files[0]
        env = env
        cwd = root
        placed = [...at.placed, ...at.given]
        links = links
        cfg = if host { ws.host_cfg } else { ws.target_cfg }
    }
    = {
        kind = "run"
        dir = run_script(ws.rust, ws.target_c, ws.libclang, spec)
        runs = []
        given = at.given
    }
}

# The name of the archiver beside the C compiler `cc`, `x86_64-linux-ar`
# beside `x86_64-linux-gcc`.
fn ar_of(cc: String) -> String {
    let name = path.basename(cc)
    = if name.ends_with("-gcc") { "{name.strip_suffix("gcc")}ar" } else { "ar" }
}

# The package `id` names.
fn package_of(ws: RustWorkspace, id: String) -> MetaPackage {
    for each in ws.metadata.packages {
        if each.id == id {
            return each
        }
    }
    panic("Cargo's plan names a package its metadata lacks, `{id}`")
}

# The settings of the package `name`: none if the workspace gives it none.
fn settings_of(ws: RustWorkspace, name: String) -> CrateSettings {
    for each in ws.crates {
        if each.package == name {
            return each
        }
    }
    = {package = name}
}

# The directory of the package whose root is at `root` in a step's sandbox:
# the workspace's own, or a vendored crate's.
fn crate_dir(ws: RustWorkspace, root: String) -> Dir {
    if root == SRC {
        return ws.src
    }
    if root.starts_with("{SRC}/") {
        return ws.src.dir(root.strip_prefix("{SRC}/"))
    }
    if root.starts_with("{VENDOR}/") {
        return ws.vendor.crates.dir(root.strip_prefix("{VENDOR}/"))
    }
    panic("a package outside the workspace and its vendored crates, at `{root}`")
}

# `text` with its ASCII letters in upper case.
fn upper(text: String): String {
    let mut out = text
    for pair in [
        ["a", "A"], ["b", "B"], ["c", "C"], ["d", "D"], ["e", "E"], ["f", "F"], ["g", "G"],
        ["h", "H"], ["i", "I"], ["j", "J"], ["k", "K"], ["l", "L"], ["m", "M"], ["n", "N"],
        ["o", "O"], ["p", "P"], ["q", "Q"], ["r", "R"], ["s", "S"], ["t", "T"], ["u", "U"],
        ["v", "V"], ["w", "W"], ["x", "X"], ["y", "Y"], ["z", "Z"],
    ] {
        out := out.split(pair[0]).join(pair[1])
    }
    = out
}

# --- The steps ---

# The crate `spec` says, compiled by rustc: the directory of what it made.
#[hermetic]
fn compile(rust: RustToolchain, spec: CompileSpec) -> Dir {
    let given = given_of(rust, spec, true)
    let box = fs.compose(given.placed).sandbox(cwd = spec.cwd)
    let ran = box.exec("{OPT_RUST}/bin/rustc", ...given.args, "--out-dir=/work/build", env = environment(given.env))
    = box.dir("/work/build")
}

# The crate `spec` says, checked by Clippy, with `flags` after its own:
# fails if a lint it denies fires.
#[hermetic]
fn clippy_checked(rust: RustToolchain, spec: CompileSpec, flags: List<String>) -> {} {
    let given = given_of(rust, spec, true)
    let driver = "{OPT_RUST}/bin/clippy-driver"
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        ...given.placed,
        {at = driver; place = rust.clippy.file("bin/clippy-driver")},
    ]
    let box = fs.compose(placed).sandbox(cwd = spec.cwd)
    let ran = box.exec(driver, ...given.args, ...flags, "--emit=metadata", "--out-dir=/work/build", env = environment(given.env))
    = {}
}

# The tests of the documentation of the library `spec` says, compiled and
# run by rustdoc, with `given` placed at their paths and `env` set: fails
# if one does.
#[hermetic]
fn doctested(
    rust: RustToolchain,
    spec: CompileSpec,
    given: List<{at: String, place: Dir | File}>,
    env: List<Entry<String>>,
) -> {} {
    let own = given_of(rust, spec, false)
    # What the crate is compiled with may already hold what its tests are
    # given, libpeios say: each path is placed once.
    let had = for each in own.placed { = each.at }
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        ...own.placed,
        ...(for each in given if not had.contains(each.at) { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = spec.cwd)
    let ran = box.exec("{OPT_RUST}/bin/rustdoc", ...own.args, env = environment([...own.env, ...env]))
    = {}
}

# The documentation of the library `spec` says, made by rustdoc, with
# `flags` after its own: the directory it wrote. Fails if rustdoc does, or
# a lint it denies fires.
#[hermetic]
fn documented(rust: RustToolchain, spec: CompileSpec, flags: List<String>) -> Dir {
    let own = given_of(rust, spec, false)
    let box = fs.compose(own.placed).sandbox(cwd = spec.cwd)
    let ran = box.exec("{OPT_RUST}/bin/rustdoc", ...own.args, ...flags, "--out-dir=/work/doc", env = environment(own.env))
    = box.dir("/work/doc")
}

# What the compile `spec` says is given in its step: its arguments, with
# what it links and searches, and what its build script said; its
# environment; and what its sandbox holds. Without `linking`, rustdoc's
# tests are given no native libraries or link arguments of their own, as
# Cargo gives them none.
fn given_of(rust: RustToolchain, spec: CompileSpec, linking: Bool) -> {
    args: List<String>,
    env: List<Entry<String>>,
    placed: List<{at: String, place: Dir | File | FileSet}>,
} {
    let mut args = spec.args
    let mut env = spec.env
    for each in spec.externs {
        args := [...args, "--extern={each.name}={each.dir.path}/{each.file}"]
    }
    for each in spec.libraries {
        args := [...args, "-Ldependency={each.path}"]
    }
    for run in spec.runs {
        args := [...args, ...said(run).search]
    }
    for run in spec.out {
        let own = said(run)
        let none: List<String> = []
        args := [...args, ...(if linking { own.libs } else { none }), ...own.cfgs, ...own.checks]
        for each in own.link_args {
            if linking and (each.kind == "" or each.kind == spec.link or "bins:{each.kind}" == spec.link or (each.kind == "bins" and spec.link.starts_with("bins:"))) {
                args := [...args, "-Clink-arg={each.arg}"]
            }
        }
        env := [...env, ...own.env, {key = "OUT_DIR"; value = OUT}]
    }
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = rust.runtime},
        {at = OPT_RUST; place = rust.root},
        {at = OPT_CC; place = rust.cc_root},
        ...(for each in spec.placed { = {at = each.at; place = each.place} }),
        ...(for each in spec.libraries { = {at = each.path; place = each} }),
        ...(for each in spec.runs { = {at = each.path; place = each} }),
        ...(for each in spec.out { = {at = OUT; place = each.dir("out")} }),
    ]
    = {args = args; env = env; placed = placed}
}

# The build script `spec` says, run: a directory of its `OUT_DIR`, `out`,
# and what it printed, `output`.
#[hermetic]
fn run_script(
    rust: RustToolchain,
    target_c: toolchain.CToolchain,
    libclang: List<Dir>,
    spec: RunSpec,
) -> Dir {
    let home = working_dir().path
    let mut env = spec.env
    env := [...env, ...cfg_env(spec.cfg.read())]
    for each in spec.links {
        let prefix = "DEP_{upper(each.links.split("-").join("_"))}_"
        for item in said(each.dir).metadata {
            env := [...env, {key = "{prefix}{upper(item.key.split("-").join("_"))}"; value = item.value}]
        }
    }
    let made = fs.mkdir("{home}/out")
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = rust.runtime},
        {at = OPT_RUST; place = rust.root},
        {at = OPT_CC; place = rust.cc_root},
        {at = OPT_TARGET_CC; place = target_c.root},
        ...(for each in libclang { = {at = OPT_LIBCLANG; place = each} }),
        {at = OUT; place = dir("{home}/out")},
        {at = spec.script.path; place = spec.script},
        ...(for each in spec.placed { = {at = each.at; place = each.place} }),
        ...(for each in spec.links { = {at = each.dir.path; place = each.dir} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = spec.cwd)
    let ran = box.exec("{spec.script.path}/{spec.program}", env = environment(env))
    for line in ran.stdout.lines() {
        let error = directive(line)
        if error.key == "error" {
            panic("the build script of `{spec.cwd}` failed: {error.value}")
        }
    }
    let output = "{home}/output"
    let printed = fs.write(output, ran.stdout)
    = fs.compose([{at = "out"; place = box.dir(OUT)}, {at = "output"; place = file(output)}])
}

# A line a build script printed, as a directive: its key and value, or an
# empty key for a line that is none.
fn directive(line: String): {key: String, value: String} {
    let rest = if line.starts_with("cargo::") {
        line.strip_prefix("cargo::")
    } else if line.starts_with("cargo:") {
        line.strip_prefix("cargo:")
    } else {
        return {key = ""; value = ""}
    }
    let parts = rest.split("=")
    if len(parts) < 2 {
        return {key = ""; value = ""}
    }
    = {key = parts[0]; value = (for k in 1..len(parts) { = parts[k] }).join("=")}
}

# What the build script whose run is `run` said: the native libraries its
# crate links and the configuration it is compiled with, the names of
# configuration it declares, the directories it and every crate after it
# search for native libraries, its OUT_DIR named by where its run is, the
# environment its crate is compiled with, the link arguments of its
# package's targets, by which they apply to, and the metadata its
# dependents' build scripts are given.
fn said(run: Dir) -> {
    libs: List<String>,
    search: List<String>,
    cfgs: List<String>,
    checks: List<String>,
    env: List<Entry<String>>,
    link_args: List<{kind: String, arg: String}>,
    metadata: List<Entry<String>>,
} {
    let mut libs: List<String> = []
    let mut search: List<String> = []
    let mut cfgs: List<String> = []
    let mut checks: List<String> = []
    let mut env: List<Entry<String>> = []
    let mut link_args: List<{kind: String, arg: String}> = []
    let mut metadata: List<Entry<String>> = []
    let out = "{run.path}/out"
    for line in run.file("output").read().lines() {
        let found = directive(line)
        let value = found.value.split(OUT).join(out)
        if found.key == "rustc-link-lib" {
            libs := [...libs, "-l{value}"]
        } else if found.key == "rustc-link-search" {
            search := [...search, "-L{value}"]
        } else if found.key == "rustc-flags" {
            let flags = flags_of(value)
            libs := [...libs, ...(for each in flags if each.starts_with("-l") { = each })]
            search := [...search, ...(for each in flags if each.starts_with("-L") { = each })]
        } else if found.key == "rustc-cfg" {
            cfgs := [...cfgs, "--cfg={value}"]
        } else if found.key == "rustc-check-cfg" {
            checks := [...checks, "--check-cfg={value}"]
        } else if found.key == "rustc-env" {
            let pair = value.split("=")
            env := [...env, {key = pair[0]; value = (for k in 1..len(pair) { = pair[k] }).join("=")}]
        } else if found.key == "rustc-link-arg" {
            link_args := [...link_args, {kind = ""; arg = value}]
        } else if found.key == "rustc-link-arg-bins" {
            link_args := [...link_args, {kind = "bins"; arg = value}]
        } else if found.key == "rustc-link-arg-bin" {
            let pair = value.split("=")
            link_args := [...link_args, {kind = pair[0]; arg = (for k in 1..len(pair) { = pair[k] }).join("=")}]
        } else if found.key == "rustc-link-arg-tests" {
            link_args := [...link_args, {kind = "tests"; arg = value}]
        } else if found.key == "rustc-cdylib-link-arg" or found.key == "rustc-link-arg-cdylib" {
            link_args := [...link_args, {kind = "cdylib"; arg = value}]
        } else if found.key == "metadata" {
            let pair = value.split("=")
            metadata := [...metadata, {key = pair[0]; value = (for k in 1..len(pair) { = pair[k] }).join("=")}]
        } else if found.key != "" and not RESERVED.contains(found.key) and not found.key.starts_with("rustc-") {
            metadata := [...metadata, {key = found.key; value = value}]
        }
    }
    = {libs = libs; search = search; cfgs = cfgs; checks = checks; env = env; link_args = link_args; metadata = metadata}
}

# The `-l` and `-L` flags of a `rustc-flags` directive's value, `value`,
# each joined to its argument, as `-lz` and `-L/lib`.
fn flags_of(value: String): List<String> {
    let words = value.fields()
    let mut flags: List<String> = []
    for k in 0..len(words) {
        let word = words[k]
        if word == "-l" or word == "-L" {
            continue
        }
        let after = k > 0 and (words[k - 1] == "-l" or words[k - 1] == "-L")
        flags := [...flags, if after { "{words[k - 1]}{word}" } else { word }]
    }
    = flags
}

# The environment Cargo gives a build script of the configuration `cfg`, as
# `rustc --print cfg` prints it: `CARGO_CFG_<KEY>`, each key's values
# joined by commas, a key with none empty.
fn cfg_env(cfg: String): List<Entry<String>> {
    let mut keys: List<String> = []
    let mut values: List<List<String>> = []
    for line in cfg.lines() {
        let parts = line.split("=")
        let key = parts[0]
        let value = if len(parts) > 1 { parts[1].strip_prefix("\"").strip_suffix("\"") } else { "" }
        let mut at = -1
        for k in 0..len(keys) {
            if keys[k] == key {
                at := k
            }
        }
        if at < 0 {
            keys := [...keys, key]
            values := [...values, if value == "" { [] } else { [value] }]
        } else if value != "" {
            values[at] := [...values[at], value]
        }
    }
    = for k in 0..len(keys) { = {key = "CARGO_CFG_{upper(keys[k])}"; value = values[k].join(",")} }
}
